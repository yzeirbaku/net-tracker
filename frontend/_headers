/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.onrender.com http://127.0.0.1:8000 http://localhost:8000; frame-ancestors 'none'; object-src 'none'; base-uri 'self'

/*.html
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=86400
